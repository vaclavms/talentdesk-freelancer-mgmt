generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum EntityType {
  FREELANCER
  VENDOR
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}

model DirectoryEntry {
  id                        String           @id @default(cuid())
  entityType                EntityType
  name                      String
  email                     String           @unique
  roleType                  String
  status                    EntityStatus     @default(ACTIVE)
  hourlyRate                Float
  currency                  String           @default("USD")
  startDate                 DateTime?
  endDate                   DateTime?
  isCompliantContract       Boolean          @default(false)
  isCompliantTax            Boolean          @default(false)
  isCompliantNda            Boolean          @default(false)
  isCompliantPaymentMethod  Boolean          @default(false)
  onboardingStatus          OnboardingStatus @default(NOT_STARTED)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  assignments               Assignment[]

  @@index([entityType, status])
  @@index([name])
}

model Project {
  id          String        @id @default(cuid())
  name        String        @unique
  clientName  String?
  status      ProjectStatus @default(PLANNED)
  budget      Float
  currency    String        @default("USD")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  assignments Assignment[]
  payments    Payment[]

  @@index([status])
}

model Assignment {
  id             String         @id @default(cuid())
  projectId      String
  talentId       String
  billRate       Float
  estimatedHours Float
  plannedCost    Float
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  talent         DirectoryEntry @relation(fields: [talentId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([talentId])
}

model Payment {
  id        String   @id @default(cuid())
  projectId String
  amount    Float
  paidDate  DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([paidDate])
}
